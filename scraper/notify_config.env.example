# 复制为服务器上的 .env（不要提交真实值到 git），crontab 运行前会 source 这个文件
NOTIFY_TO_EMAIL=you@example.com
GMAIL_USER=youraccount@gmail.com
# 在 https://myaccount.google.com/apppasswords 生成的 16 位 App Password（需要先开二步验证）
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_CATEGORY=EB2
NOTIFY_COUNTRY=China
NOTIFY_CHART=A
NOTIFY_PRIORITY_DATE=2021-06-01
